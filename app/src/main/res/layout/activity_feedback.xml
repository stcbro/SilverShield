<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="提交反馈"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="哪些 App 的广告没被自动跳过？填写并说明，开发者会补规则或修复程序。"
            android:textColor="@color/text_sub"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="没跳过的 App 名称"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_white"
            android:hint="请填写没跳过的 App 名称（多个用、或逗号分隔）"
            android:inputType="text"
            android:minHeight="56dp"
            android:padding="14dp"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="问题描述（可选）"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_white"
            android:gravity="top"
            android:hint="例如：开屏广告有『跳过』按钮但点不动 / 信息流广告关不掉 / 弹窗误关了正常内容 ..."
            android:inputType="textMultiLine"
            android:minHeight="120dp"
            android:padding="14dp"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="将自动附带以下信息，便于开发者定位："
            android:textColor="@color/text_sub"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_white"
            android:padding="14dp"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/purple_500"
            android:text="发送反馈"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/gray"
            android:text="复制反馈内容"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
