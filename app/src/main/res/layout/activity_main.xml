<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题区：盾徽 + 应用名（顶部靠左）+ 一行小字副标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBadge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_shield_badge" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_main"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="帮长辈自动跳过开屏广告与烦人弹窗"
                android:textColor="@color/text_sub"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- 状态大卡（Clash 风格）：点击切换 守护中 ↔ 已停止（纯显示开关） -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_status_off"
            android:orientation="horizontal"
            android:padding="26dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="守护状态"
                android:src="@drawable/ic_w_check" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_off"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/hint_off"
                    android:textColor="#EAEAEA"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 白色圆角卡：设置（Clash 的「配置」卡样式） -->
        <LinearLayout
            android:id="@+id/rowSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_green"
                android:contentDescription="设置"
                android:padding="12dp"
                android:src="@drawable/ic_w_gear" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textColor="@color/text_main"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="开启无障碍 · 后台保活"
                    android:textColor="@color/text_sub"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 独立菜单行：守护统计 -->
        <LinearLayout
            android:id="@+id/rowStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_blue"
                android:contentDescription="守护统计"
                android:padding="12dp"
                android:src="@drawable/ic_w_chart" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="守护统计"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 独立菜单行：语音播报 -->
        <LinearLayout
            android:id="@+id/rowVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_orange"
                android:contentDescription="语音播报"
                android:padding="12dp"
                android:src="@drawable/ic_w_volume" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="语音播报"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 独立菜单行：使用说明（点击弹出） -->
        <LinearLayout
            android:id="@+id/rowHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_purple"
                android:contentDescription="使用说明"
                android:padding="12dp"
                android:src="@drawable/ic_w_help" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="使用说明"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 独立菜单行：提交反馈 -->
        <LinearLayout
            android:id="@+id/rowFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_silver"
                android:contentDescription="提交反馈"
                android:padding="12dp"
                android:src="@drawable/ic_w_feedback" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="提交反馈"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 版本号 -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:textColor="@color/gray"
            android:textSize="15sp"
            tools:text="版本 v1.4.3" />

        <!-- 版权声明 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="© 2026 Bro.Cui · 开源公益，仅供学习交流使用"
            android:textColor="@color/gray"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
