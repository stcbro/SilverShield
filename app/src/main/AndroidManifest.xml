<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 自动更新规则需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 可选：用于"分享给子女" -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 自动升级：允许请求安装本应用下载的升级包 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 11+ 包可见性：查询其他应用的名称（统计页显示中文应用名必需） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 居中提示浮层需要（Android 12+ 自定义 Toast 已失效，改用 WindowManager 浮层）。未授予时自动降级为标准 Toast。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SilverShield">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 提交反馈：收集用户遇到的无效 App 与问题，便于补充规则/修复 -->
        <activity
            android:name=".FeedbackActivity"
            android:exported="false" />

        <!-- 引导浮层：透明、触摸穿透，固定显示 2 秒后自动关闭 -->
        <activity
            android:name=".GuideOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.GuideOverlay"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <service
            android:name=".SkipAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 通知栏开关：接收通知按钮的「暂停/恢复守护」意图 -->
        <receiver
            android:name=".ShieldToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.silvershield.app.ACTION_TOGGLE_SHIELD" />
            </intent-filter>
        </receiver>

        <!-- 自动升级：供安装器读取下载的升级包 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.silvershield.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
